<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="../../css/join.css">
</head>

<body>
    <div class="continer">
        <div class="sig-continer">
            <section class="image-section">
                <div class="image-box">
                    
                </div>
            </section>
            <section class="form-continer">
                <!-- top logo section and arrow button -->
                <div class="log-section">
                    <div class="box"">
                        <img src="../../images/icons/arrowBack.png" alt="" >
                    </div>
                    
                </div>
                <!-- sigup title and sub-title section -->
                <div class="title-continer">
                    <div class="title">
                        <h3 class="signup-title">Sign Up Now</h3>
                    </div>
                    <div class="sub-title">
                        <p class="signup-subtitle">Welcome to Nuru Studio. a space built for architects. interior
                            designers, and creative builders who believe in the power of design to shape better
                            environments.</p>

                    </div>
                </div>
                <!-- form section -->
                <form action="#" method="post" class="form-section">
                    <div class="username formInput">
                        <label for="username" >Full Name</label>
                        <input type="text" name="username" id="username" placeholder="User name" >
                    </div>

                    

                    <div class="email formInput">
                        <label for="email">Email Address</label>
                        <input type="email" name="email" id="email" placeholder="e.g example@gmail.com">
                    </div>
                    <div class="password-box ">
                        <div class="password formInput">
                            <label for="password">Password</label>
                            <div class="box-p ">
                                <input type="password" name="password" id="password"
                                    placeholder="Enter Strong Password">
                                    <!-- <img src="./eye.png" alt="" height="14rem"> -->
                            </div>

                        </div>
                        <div class="password formInput">
                            <label for="phone-n">Phone</label>
                            <div class="box-p ">
                                <input type="text" name="phone" id="phone-n" placeholder="Phone Number">
                                <!-- <img src="./eye.png" alt="" height="14rem" > -->
                            </div>
                        </div>
                    </div>
                   
                      <div class="username formInput">
                        <label for="address" >Address</label>
                        <input type="text" name="address" id="address" placeholder="Enter your address" >
                    </div>
                    

                    <div class="signup-button ">
                        <button type="submit" class="button">Sign Up</button>
                    </div>
                    <div class="last-p">
                        <p>Already a member? &nbsp;<a href="#"> Log In</a></p>
                    </div>
                </form>
            </section>
        </div>
    </div>
</body>

</html>