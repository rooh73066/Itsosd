<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="../../css/signin.css">
</head>

<body>
    <div class="continer">
        <div class="sig-continer">
            <section class="image-section">
                <div class="image-box">
                    <h2>Design Your Future</h2>
                    <p>
                        Create beautiful experiences with Nuru Studio.
                    </p>
                </div>
            </section>
            <section class="form-continer">
                <!-- top logo section and arrow button -->
                <div class="log-section">
                    <div class="box"><a href="/">
                        <img src="../../images/icons/arrowBack.png" alt="Back">
                        </a>

                    </div>

                </div>
                <!-- sigup title and sub-title section -->
                <div class="title-continer">
                    <div class="title">
                        <h3 class="signup-title">Sign Up Now</h3>
                    </div>
                    <div class="sub-title">
                        <p class="signup-subtitle">Welcome to Nuru Studio. a space built for architects. interior
                            designers, and creative builders who believe in the power of design to shape better
                            environments.</p>

                    </div>
                </div>
                <% if (typeof errorMessage !== "undefined") { %>
                    <p role="alert"><%= errorMessage %></p>
                <% } %>
                <!-- form section -->
                <form action="/login" method="post" class="form-section">
                    <div class="email formInput">
                        <label for="email">Email Address</label>
                        <input type="email" name="email" id="email" placeholder="e.g example@gmail.com" autocomplete="email" required>
                    </div>

                    <div class="username formInput">
                        <label for="password">Password</label>
                        <input type="password" name="password" id="password" placeholder="Password" autocomplete="current-password" required>
                    </div>

                    <div class="signup-button ">
                        <button type="submit" class="button">Sig In</button>
                    </div>
                    <div class="last-p">
                        <p>Need an account? &nbsp;<a href="/signup">Sign Up</a></p>
                    </div>
                </form>
            </section>
        </div>
    </div>
</body>

</html>