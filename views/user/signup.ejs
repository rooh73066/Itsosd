<!DOCTYPE html>

<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up</title>
<link rel="stylesheet" href="../../css/sigup.css">

</head>

<body>

<main class="container">

    <div class="signup-container">

        <!-- Image Section -->
        <section class="image-section">
            <div class="image-box">
                <h2>Design Your Future</h2>
                <p>
                    Create beautiful experiences with Nuru Studio.
                </p>
            </div>
        </section>


        <!-- Form Section -->
        <section class="form-container">

            <!-- Back Button -->
            <div class="logo-section">
                <a href="/" class="back-button">
                    <img src="../../images/icons/arrowBack.png" alt="Back">
                </a>
            </div>


            <!-- Title -->
            <div class="title-container">

                <div class="title">
                    <h1 class="signup-title">Sign Up Now</h1>
                </div>

                <div class="sub-title">
                    <p class="signup-subtitle">
                        Welcome to Nuru Studio, a space built for architects,
                        interior designers, and creative builders who believe
                        in the power of design to shape better environments.
                    </p>
                </div>

            </div>

            <% if (typeof errorMessage !== "undefined") { %>
                <p class="error-message" role="alert"><%= errorMessage %></p>
            <% } %>

            <!-- Signup Form -->
            <form action="/signup" method="post" class="form-section" id="signupForm" novalidate>

                <!-- Full Name -->
                <div class="form-input">
                    <label for="username">Full Name</label>

                    <input
                        type="text"
                        name="username"
                        id="username"
                        placeholder="Enter your full name"
                        autocomplete="name"
                        required
                    >

                    <small class="error-message" id="usernameError"></small>
                </div>


                <!-- Email -->
                <div class="form-input">
                    <label for="email">Email Address</label>

                    <input
                        type="email"
                        name="email"
                        id="email"
                        placeholder="e.g. example@gmail.com"
                        autocomplete="email"
                        required
                    >

                    <small class="error-message" id="emailError"></small>
                </div>


                <!-- Password + Phone -->
                <div class="password-box">

                    <!-- Password -->
                    <div class="form-input">
                        <label for="password">Password</label>

                        <div class="input-wrapper">
                            <input
                                type="password"
                                name="password"
                                id="password"
                                placeholder="Enter strong password"
                                autocomplete="new-password"
                                required
                            >

                            <button
                                type="button"
                                class="show-password"
                                id="togglePassword"
                            >
                                Show
                            </button>
                        </div>

                        <small class="error-message" id="passwordError"></small>
                    </div>


                    <!-- Phone -->
                    <div class="form-input">
                        <label for="phone-n">Phone</label>

                        <input
                            type="tel"
                            name="phone"
                            id="phone-n"
                            placeholder="Phone Number"
                            autocomplete="tel"
                            required
                        >

                        <small class="error-message" id="phoneError"></small>
                    </div>

                </div>


                <!-- Address -->
                <div class="form-input">
                    <label for="address">Address</label>

                    <input
                        type="text"
                        name="address"
                        id="address"
                        placeholder="Enter your address"
                        autocomplete="street-address"
                    >

                    <small class="error-message" id="addressError"></small>
                </div>


                <!-- Submit Button -->
                <div class="signup-button">
                    <button type="submit" class="button">
                        Sign Up
                    </button>
                </div>


                <!-- Login -->
                <div class="last-p">
                    <p>
                        Already a member?
                        <a href="/sigin">Log In</a>
                    </p>
                </div>

            </form>

        </section>

    </div>

</main>


<script src="../../js/join.js"></script>

</body>
</html>