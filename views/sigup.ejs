<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>sig up</title>

     <!------------------------- matual styling ------------------------ -->
    <link rel="stylesheet" href="../css/sigup.css">
    <link rel="stylesheet" href="../css/nav-footer.css">
</head>

<body>
   
    <div class="continer">
       
        <form  action="#" method="POST" class="singin-page" >
             <div class="back-button">
            <a href="/"><img src="../images/icons/arrowBack.png" alt=""></a>
        </div>
            <h1>Sign Up</h1>
                <div class="user-box input-box">
                    <input 
                    type="text"
                     name="name" 
                     required 
                     placeholder="User name" >
                </div>
                <div class="email-box input-box">
                    <input type="email" name="email" placeholder="Email" required>
                </div>
                <div class="password-box input-box">
                    <input type="password" name="password" placeholder="Password" required>
                </div>

                <div class="password-box input-box">
                    <input type="date" name="dob" >
                </div>
                <div class="password-box input-box">
                    <input type="text" name="address" placeholder="Address" >
                </div>
                <div class="password-box input-box">
                    <input type="number" name="number" placeholder="Phone" required>
                </div>
                <div class="remember-box">
                    <div>
                        <input type="checkbox" name="remember"> &nbsp; Remember me
                    </div>

                    <a href="#">Forgot Password ?</a>
                </div>
                <div class="login-box">
                    <button type="submit">Sign Up</button>
                </div>
                <div class="account-box">
                    <p>Dont's have on account : <a href="/sigin">Login</a></p>
                </div>
            
        </form>
    </div>
</body>

</html>


