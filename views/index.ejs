<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="../css/index.css">
    <link rel="stylesheet" href="../css/nav-footer.css">

</head>

<body>

    <!-- ======================================nav bar section=============================== -->
       <%- include("./component/navbar") %>
    <!-- ===================================hero section=============================== -->
    <div class="hero-continer">
        <div class="hero-content">
            <hero class="info">
                <h1 class="hero-contentTitle">Digital Solutions Designed to Move Your Business Forward </h1>
                <p class="heroList">Your vision, our creativity, and the right technology- together, we reate meaningful
                    digital exeriences
                    that make an imact. We help businesses build a stronger online presence, attract and engage their
                    audience, improve customer
                    experiences, increase credibility, streamline their digital operations, and create lasting
                    opportunities for growth.
                </p>
                <div class="hero-btn">
                    <a href="/services" class="hero-btnLink">View Our Services</a>
                </div>
                <p class="money-box">Creative Solutions - Modern Technology - Reliable Support</p>
            </hero>
            <div class="hero-image">
                <img src="../images/service.png" alt="">
            </div>
        </div>
    </div>
    <!------------------------------------performance section---------------------------->
    <div class="performance-continer">
        <div class="boxOne div1">
            <p>10 M+</p>
            <h5>Happy Customers</h5>
        </div>
        <div class="boxOne div2">
            <p>12 M+</p>
            <h5>Years of Service</h5>
        </div>
        <div class="boxOne div3">
            <p>8 M+</p>
            <h5>Complete Projects</h5>
        </div>
    </div>

    <!-- ===================================about section start =============================== -->
    <div class="about-continer">
        <div class="about-section">
            <div class="about-image-section">
                <img src="../images/about.png" alt="" class="about-image">
            </div>
            <div class="about-info-section">
                <div class="abouttitle">
                    <h5 class="title">We Transform Your Vision Into Powerful Digital Experiences That Inspire Growth</h5>
                </div>
                <div class="about-subtitle">
                    <p class="subtitle">
                        At <b>ITSOSD</b>, we transform ideas into meaningful digital experiences that help businesses
                        build, grow,and stand out in a competivitve digital world.
                    </p>
                    <p class="subtitle">
                         We work with businesses, startups entrepreneurs, and organizations to create professional 
                                digital solutions that are designed around their unique goals and audience. From the first idea 
                                to the final product, we focus on combining creativity, technology, and throughtful strategy.
                    </p>

                     <p class="subtitle">
                        Our approach is simple : understand your vision, create with purpose, and deliver with quality.
                    </p>

                </div>
                <div class="about-btn">
                    <a href="./about" class="button">Learn More About Us &rightarrow;</a>
                </div>
            </div>
        </div>
    </div>

    <!-- ===================================top services section =============================== -->
    <div class="card-continer">
        <div class="card-section">
            <div class="card-section-title">
                <h6 class="h6">HOW CAN WE HELP?</h6>
                <h3 class="h3">View our Services</h3>
            </div>
            <div class="main-card-section">
                <!-- ---------------------cards----------------------- -->
                <div class="main-card">
                    <div class="image-section">
                        <img src="../images/poster14-programming.jpg" alt="service image"
                            class="serviceCardImage">
                    </div>
                    <div class="card-title">
                        <h2 class="h2">Web Development</h2>
                    </div>
                    <div class="card-subTitle">
                        <p>We build fast, responsive, secure, and user-friendly websites that strengthen your online presence and help your business grow.</p>
                    </div>
                    <div class="card-lastLink">
                        <a href="/service" class="learn-more">LEARN MORE</a>
                    </div>
                </div>

                <!-- ---------------------cards----------------------- -->
                <div class="main-card">
                    <div class="image-section">
                        <img src="../images/poster15-backend.jpg" alt="service image" class="serviceCardImage">
                    </div>
                    <div class="card-title">
                        <h2 class="h2">raphic Design</h2>
                    </div>
                    <div class="card-subTitle">
                        <p>We create creative, professional, and visually engaging designs that strengthen your brand identity and leave a lasting impression on your audience.</p>
                    </div>
                    <div class="card-lastLink">
                        <a href="#" class="learn-more">LEARN MORE</a>
                    </div>
                </div>

                <div class="main-card">
                    <div class="image-section">
                        <img src="../images/poster13-marketing.jpg" alt="service image" class="serviceCardImage">
                    </div>
                    <div class="card-title">
                        <h2 class="h2">UI/UX Design</h2>
                    </div>
                    <div class="card-subTitle">
                        <p>We design intuitive, engaging, and user-friendly interfaces that create seamless experiences, improve usability, and keep your audience connected.</p>
                    </div>
                    <div class="card-lastLink">
                        <a href="#" class="learn-more">LEARN MORE</a>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <!-- ===================================what we do section start =============================== -->
    <div class="work-process-continer">
        <div class="work-process-section">
            <div class="work-info">
                <h4 class="h4">How We Work</h4>
                <h6 class="h6">From Idea to Launch</h6>
                <p class="p">We follow a simple and structured process to turn your ideas into effective digital solutions. From the first conversation to final delivery, we work closely with you to ensure your project meets your goals.</p>
            </div>
            <div class="workcard-coninter">
                <!--------------card one ------------>
                <div class="card">
                    <div class="icon-sec"><img src="../images/icons/checkBox.png" alt="" class="img"></div>
                    <h4 class="title">1. Analysis</h4>
                    <p class="subtitle">We carefully analyze your requirements and define the key features, functionality, and objectives needed for your project.</p>
                    <div class="link"><a href="" class="alink">More</a></div>
                </div>

                <!--------------card one ------------>
                <div class="card">
                    <div class="icon-sec"><img src="../images/icons/checkBox.png" alt="" class="img"></div>
                    <h4 class="title">2.Planning</h4>
                    <p class="subtitle">We create a clear project plan covering the structure, priorities, technology, timeline, and overall direction of the project.</p>
                    <div class="link"><a href="" class="alink">More</a></div>
                </div>

                <!--------------card one ------------>
                <div class="card">
                    <div class="icon-sec"><img src="../images/icons/checkBox.png" alt="" class="img"></div>
                    <h4 class="title">3. 04. Design</h4>
                    <p class="subtitle">We create a clean, modern, and user-friendly design that reflects your brand and provides a smooth experience for your users.</p>
                    <div class="link"><a href="" class="alink">More</a></div>
                </div>

                <!--------------card one ------------>
                <div class="card">
                    <div class="icon-sec"><img src="../images/icons/checkBox.png" alt="" class="img"></div>
                    <h4 class="title">4.Development</h4>
                    <p class="subtitle">We turn the approved designs into a functional digital solution, focusing on quality, performance, responsiveness, and reliability.</p>
                    <div class="link"><a href="" class="alink">More</a></div>
                </div>

                <!--------------card one ------------>
                <div class="card">
                    <div class="icon-sec"><img src="../images/icons/checkBox.png" alt="" class="img"></div>
                    <h4 class="title">5. Testing</h4>
                    <p class="subtitle">We thoroughly test the project to identify and fix issues while checking functionality, responsiveness, performance, and compatibility.</p>
                    <div class="link"><a href="" class="alink">More</a></div>
                </div>

                <!--------------card one ------------>
                <div class="card">
                    <div class="icon-sec"><img src="../images/icons/checkBox.png" alt="" class="img"></div>
                    <h4 class="title">6. Launch</h4>
                    <p class="subtitle">Once everything is ready and approved, we deploy your project and make it available to your customers and users.</p>
                    <div class="link"><a href="" class="alink">More</a></div>
                </div>

            </div>
        </div>
    </div>
    <!-- ===================================out cliends say section start =============================== -->

    <!-- ===================================footer section start =============================== -->
     <%- include("./component/footer") %>
    

</body>

</html>