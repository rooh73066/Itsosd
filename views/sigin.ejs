<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>sig in</title>

     <!------------------------- matual styling ------------------------ -->
    <link rel="stylesheet" href="../css/sigup.css">
</head>

<body>
   <!--=======sigin  section start =============== -->
    <div class="continer">
       
        <form  action="#" method="POST" class="singin-page" style="position: relative; right: 444px;">
             <div class="back-button">
            <a href="/"><img src="../images/icons/arrowBack.png" alt=""></a>
        </div>
            <h1>Sign In</h1>
                
                <div class="email-box input-box">
                    <input type="email" name="email" placeholder="Email" required>
                </div>
                <div class="password-box input-box">
                    <input type="password" name="password" placeholder="Password" required>
                </div>

                <div class="remember-box">
                    <div>
                        <input type="checkbox" name="remember"> &nbsp; Remember me
                    </div>

                    <a href="#">Forgot Password ?</a>
                </div>
                <div class="login-box">
                    <button type="submit">Sign In</button>
                </div>
                <div class="account-box">
                    <p>Dont's have on account : <a href="/sigup">Sig Up</a></p>
                </div>
            
        </form>
    </div>
</body>

</html>


